{
  "schema": "flexdiffusion-bend-grid/v1",
  "request": {
    "prompt": "humanoid dinosaur cyborg mercenary holding a futuristic kinetic anti-materiel rifle, science fiction illustration",
    "negative_prompt": "human face, human skin, text, watermark",
    "seed": 2, "width": 512, "height": 512, "num_outputs": 1,
    "num_inference_steps": 16, "guidance_scale": 10, "sampler_name": "plms",
    "use_stable_diffusion_model": "sd-v1-4",
    "circuit_bend": {
      "enabled": true, "mode": "plms_history", "schedule": "exact",
      "history_source": "seed", "donor_seed": 5, "blend_target": "independent",
      "blend_curve": "oscillate", "blend_start": 0, "blend_end": 1,
      "blend_period": 8, "history_strength": 1
    }
  },
  "x": { "key": "blend_period", "values": [2, 4, 8] },
  "y": { "key": "blend_end", "values": [0.5, 1] },
  "seeds": [2, 3, 4, 5], "baseline": true
}
